# Copy from the setup-generated .env.hermes, or configure an existing gateway.
HERMES_BASE_URL=http://127.0.0.1:8642
# Must match API_SERVER_KEY in the dedicated Hermes home; keep this server-side.
HERMES_API_KEY=
# Gateway alias; the underlying Qwen model is configured in Hermes config.yaml.
HERMES_MODEL=hermes-agent
HERMES_TIMEOUT_SECONDS=120
# Shared secret for the runtime to call this backend's agent tools at /mcp.
MULA_TOOLS_KEY=
# Seed for each account's runtime profile key; keep it server-side and stable.
MULA_PROFILE_KEY_SEED=
# The application database. Homebrew: postgresql://localhost/mula
# docker compose: postgresql://mula:<password from .env.postgres>@127.0.0.1:5432/mula
MULA_DATABASE_URL=
# Where per-account files (memory stores) live; defaults to .runtime at the repository root.
# MULA_DATA_DIR=
# Model address the Hermes profiles use. Default: local Ollama. In Docker: http://host.docker.internal:11434/v1.
MULA_MODEL_BASE_URL=http://127.0.0.1:11434/v1
